# PUBLIC SITE NUMBER — set this to the HushSMS number you purchase.
# For a Kosovo/non-US test, a nearby HushSMS mobile line such as Serbia (+381) is practical.
PUBLIC_PHONE_NUMBER=
PUBLIC_PHONE_DISPLAY=

# HushSMS — crypto-paid carrier number + inbound webhook + outbound REST replies.
HUSHSMS_API_BASE=https://api.hushsms.com
HUSHSMS_LINE_ID=
HUSHSMS_LINE_TOKEN=
HUSHSMS_WEBHOOK_SECRET=
HUSHSMS_VALIDATE_SIGNATURE=true

# Durable conversation state. Required for production serverless deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Robinhood Chain / Pons v2
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# Leave blank to automatically select the first enabled launch config at launch time.
PONS_LAUNCH_CONFIG_ID=

# Dedicated low-balance launcher wallet. Never use a treasury wallet.
LAUNCHER_PRIVATE_KEY=
# Optional public address for gate/status checks before adding the private key.
LAUNCHER_ADDRESS=

# SAFE DEFAULTS
# dry-run = complete the whole SMS conversation without a transaction.
# mainnet = permit the final confirmation to reach the onchain executor.
EXECUTION_MODE=dry-run
# Separate kill switch. Both mainnet mode AND this must be enabled to broadcast.
ENABLE_ONCHAIN_LAUNCH=false
ENABLE_WEB_TESTER=true
