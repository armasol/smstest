# PUBLIC SITE NUMBER — set this to the HushSMS number you purchase.
# For a Kosovo/non-US test, a nearby HushSMS mobile line such as Serbia (+381) is practical.
PUBLIC_PHONE_NUMBER=
PUBLIC_PHONE_DISPLAY=

# HushSMS — crypto-paid carrier number + inbound webhook + outbound REST replies.
HUSHSMS_API_BASE=https://api.hushsms.com
HUSHSMS_LINE_ID=
HUSHSMS_LINE_TOKEN=
HUSHSMS_WEBHOOK_SECRET=
HUSHSMS_VALIDATE_SIGNATURE=true

# Durable conversation state, webhook dedup, and launch claims. Required for
# production serverless deployment. Use the Supabase integration's service-role
# credentials — never the anon/publishable key, since these tables have no
# public RLS policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used to build the /claim/:token wallet-approval links texted
# to customers. Falls back to VERCEL_URL if unset.
PUBLIC_SITE_URL=

# Robinhood Chain / Pons v2
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# Leave blank to automatically select the first enabled launch config at launch time.
PONS_LAUNCH_CONFIG_ID=

# Optional. This flow is fully non-custodial — the customer's own wallet signs
# and broadcasts every launch. These are only used for the read-only
# canLaunch()/gate diagnostic surfaced on /api/status, never to sign a transaction.
LAUNCHER_PRIVATE_KEY=
LAUNCHER_ADDRESS=

# SAFE DEFAULTS
# dry-run = complete the whole SMS conversation without ever creating a claim link.
# mainnet = CONFIRM texts back a /claim/:token link; the customer's wallet signs it.
EXECUTION_MODE=dry-run
ENABLE_WEB_TESTER=true
